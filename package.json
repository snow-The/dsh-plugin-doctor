{
  "name": "@snow-the/dsh-plugin-doctor",
  "version": "0.2.0",
  "description": "Static pre-install vetting for DSH plugins: scans a directory or installed package for exfiltration, credential access, obfuscation, persistence and lifecycle-script red flags (own-built, replacing third-party vetting plugins).",
  "type": "module",
  "main": "./dist/index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "security",
    "vetting",
    "deepseek-harness"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@deepseek-ai/* --log-level=warning",
    "test": "node --test"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": [
        "0.2.0-rc.1",
        "0.2.0-rc.2",
        "0.2.1-rc.1",
        "0.2.1-rc.2"
      ],
      "verifiedAgainst": "0.2.1-rc.2"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/snow-The/dsh-own-plugins.git",
    "directory": "dsh-plugin-doctor"
  },
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  }
}
